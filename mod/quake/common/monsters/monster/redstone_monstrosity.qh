#pragma once

#include "../all.qh"

MSG_INFO_NOTIF(DEATH_SELF_MON_REDSTONE_MONSTROSITY,                     1,  2, 0, "s1 s2", "",        "",                     _("^BG%s%s^K1 was slammed by the Redstone Monstrosity"), "")
MSG_MULTI_NOTIF(DEATH_SELF_MON_REDSTONE_MONSTROSITY,                1,  NULL,           INFO_DEATH_SELF_MON_REDSTONE_MONSTROSITY,               CENTER_DEATH_SELF_MONSTER)
REGISTER_DEATHTYPE(MONSTER_REDSTONE_MONSTROSITY,            DEATH_SELF_MON_REDSTONE_MONSTROSITY,            DEATH_MURDER_MONSTER,           "monster")

#ifdef GAMEQC
MODEL(MON_REDSTONE_MONSTROSITY, "progs/redstone_monstrosity.mdl");
#endif

CLASS(RedstoneMonstrosity, Monster)
    ATTRIB(RedstoneMonstrosity, spawnflags, int, MON_FLAG_BLOCKY | MONSTER_TYPE_BOSS | MON_FLAG_EXPLOSIONRESISTANT | MON_FLAG_APPEAR);
    ATTRIB(RedstoneMonstrosity, m_mins, vector, '-48 -48 -24');
    ATTRIB(RedstoneMonstrosity, m_maxs, vector, '48 48 128');
#ifdef GAMEQC
    ATTRIB(RedstoneMonstrosity, m_model, Model, MDL_MON_REDSTONE_MONSTROSITY);
#endif
    ATTRIB(RedstoneMonstrosity, netname, string, "redstone_monstrosity");
    ATTRIB(RedstoneMonstrosity, m_name, string, _("Redstone Monstrosity"));
    ATTRIB(RedstoneMonstrosity, m_color, vector, '1 0.11 0.11');
ENDCLASS(RedstoneMonstrosity)

REGISTER_MONSTER(REDSTONE_MONSTROSITY, NEW(RedstoneMonstrosity));
