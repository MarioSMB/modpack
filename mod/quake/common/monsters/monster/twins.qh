#pragma once

#include "../all.qh"

CLASS(Twins, Monster)
    ATTRIB(Twins, spawnflags, int, MON_FLAG_HIDDEN | MONSTER_TYPE_CONTROLLER);
    ATTRIB(Twins, m_mins, vector, '0 0 0');
    ATTRIB(Twins, m_maxs, vector, '0 0 0');
#ifdef GAMEQC
    ATTRIB(Twins, m_model, Model, MDL_Null);
#endif
    ATTRIB(Twins, netname, string, "twins");
    ATTRIB(Twins, m_name, string, "The Twins"); // dummy name
    ATTRIB(Twins, m_color, vector, '0.66 0.11 0.11');
ENDCLASS(Twins)

REGISTER_MONSTER(TWINS, NEW(Twins));

#ifdef SVQC
.int twins_attackcount;

vector twins_repel(entity this, vector point, float maximal_distance);

void twins_anim(entity this);

void twins_move(entity this, vector goal, float velmax, float turnrate);

void twins_brake(entity this, float brakespeed);

void twins_setangle(entity this, vector goal);

entity twins_pickmovegoal(entity this);
#endif
