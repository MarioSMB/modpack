#pragma once

// since all presents are basically the same, we can share a lot of information!

CLASS(JesterPresents, Turret)
#ifdef GAMEQC
/* spawnflags */ ATTRIB(JesterPresents, spawnflags, int, TUR_FLAG_NOJESTER);
/* mins       */ ATTRIB(JesterPresents, m_mins, vector, '-16 -16 0');
/* maxs       */ ATTRIB(JesterPresents, m_maxs, vector, '16 16 42');
/* head_model */ ATTRIB(JesterPresents, head_model, string, "null");
#endif
#ifdef GAMEQC
/* health     */ ATTRIB(JesterPresents, health, float, 200);
/* champion   */ ATTRIB(JesterPresents, m_champion, Champions, CHAMPION_Jester);
#endif
ENDCLASS(JesterPresents)

#ifdef SVQC
enum {
	PRESENT_TURRET,
	PRESENT_FUEL,
	PRESENT_EQUIPMENT,
	PRESENT_SHAMBLER
};
#endif

// ===============
//  SMALL PRESENT
// ===============

CLASS(JesterSmallPresent, JesterPresents)
#ifdef GAMEQC
/* modelname  */ ATTRIB(JesterSmallPresent, mdl, string, "progs/tur_present1.mdl");
#endif
/* netname    */ ATTRIB(JesterSmallPresent, netname, string, "smallpresent");
/* fullname   */ ATTRIB(JesterSmallPresent, m_name, string, _("Small Present"));
#ifdef GAMEQC
/* number     */ ATTRIB(JesterSmallPresent, impulse, int, 0);
/* cost       */ ATTRIB(JesterSmallPresent, tur_cost, float, 40);
/* units      */ ATTRIB(JesterSmallPresent, tur_units, int, 2);
#endif

ENDCLASS(JesterSmallPresent)
REGISTER_TURRET(SMALL_PRESENT, NEW(JesterSmallPresent));

