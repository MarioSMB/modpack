	return REGISTRY_GET(Sounds, SND_Jester_Jump1.m_id + rint(random() * 4));
}

SOUND(Jester_Gasp1, "player_jester/gasp1");
SOUND(Jester_Gasp2, "player_jester/gasp2");
SOUND(Jester_WaterDeath, "player_jester/h2odeath");
