#ifdef CSQC
#define JESTER_STATS \
"^F1A sly trickster born in a whimsical realm of chaos, the ^C1Jester^F1's true motives are shrouded in mystery\n\n\n" \
"^2+20% movement speed\n" \
"^2+15% jump height\n" \
"^x0FFMagic proficiency (^2-20% cost^x0FF, ^2+50% damage^x0FF)\n" \
"Press %ABILITY% to activate ^3Wheel o' Fortuna^7:\n" \
"%SUB% Certain combinations can have crazy effects!\n" \
"^2+25% weapon fire rate"
#endif
CLASS(Jester, Champions)
	ATTRIB(Jester, netname, string, "jester");
	ATTRIB(Jester, m_name, string, "Jester");
	ATTRIB(Jester, m_color, vector, '0.6 0.35 0.72');
	ATTRIB(Jester, qcc_jumpheight, float, 1.15);
	ATTRIB(Jester, qcc_meleename, string, "squireaxe");
	ATTRIB(Jester, qcc_manacost, float, 0.8);
	ATTRIB(Jester, qcc_attackrate, float, 0.75);
#ifdef GAMEQC
	ATTRIB(Jester, m_model, Model, MDL_Jester);
	ATTRIB(Jester, m_model_head, Model, MDL_Jester_Head);
	METHOD(Jester, m_sound_pain, Sound()) { return SND_Jester_Pain_Random(); }
	METHOD(Jester, m_sound_death, Sound()) { return SND_Jester_Death_Random(); }
	METHOD(Jester, m_sound_jump, Sound(entity actor)) { return SND_Jester_Jump_Random(); }
	METHOD(Jester, m_sound_waterdeath, Sound(entity actor)) { return SND_Jester_WaterDeath; }
	METHOD(Jester, m_sound_gasp1, Sound(entity actor)) { return SND_Jester_Gasp1; }
	METHOD(Jester, m_sound_gasp2, Sound(entity actor)) { return SND_Jester_Gasp2; }
	METHOD(Jester, m_sound_axehit, Sound(entity actor)) { return SND_Jester_AxeHit; }
	METHOD(Jester, m_sound_burn, Sound(entity actor)) { return SND_Jester_Burn_Random(); }
	METHOD(Jester, m_sound_drown, Sound(entity actor)) { return SND_Jester_Drown_Random(); }
	METHOD(Jester, m_sound_land, Sound(entity actor)) { return SND_Jester_Land; }
	METHOD(Jester, m_sound_fall, Sound(entity actor)) { return SND_Jester_Fall; }
#endif
#ifdef CSQC
	ATTRIB(Jester, message, string, JESTER_STATS);
#endif
	ATTRIB(Jester, td_turrets, bool, true);
ENDCLASS(Jester)
REGISTER_CHAMPION(Jester, NEW(Jester));

#ifdef CSQC
#undef JESTER_STATS
#endif

#ifdef SVQC
.bool jester_cannon;
#endif
