#include "../all.qh"

#ifdef GAMEQC
MODEL(Jester, "progs/player_jester.mdl");
MODEL(Jester_Head, "progs/h_player_jester.mdl");

SOUND(Jester_Pain1, "player_jester/hurt1");
SOUND(Jester_Pain2, "player_jester/hurt2");
SOUND(Jester_Pain3, "player_jester/hurt3");
SOUND(Jester_Pain4, "player_jester/hurt4");
Sound SND_Jester_Pain_Random() {
	return REGISTRY_GET(Sounds, SND_Jester_Pain1.m_id + rint(random() * 3));
}

SOUND(Jester_Death1, "player_jester/death1");
SOUND(Jester_Death2, "player_jester/death2");
SOUND(Jester_Death3, "player_jester/death3");
Sound SND_Jester_Death_Random() {
	return REGISTRY_GET(Sounds, SND_Jester_Death1.m_id + rint(random() * 2));
}

SOUND(Jester_Jump1, "player_jester/jump1");
SOUND(Jester_Jump2, "player_jester/jump2");
SOUND(Jester_Jump3, "player_jester/jump3");
SOUND(Jester_Jump4, "player_jester/jump4");
SOUND(Jester_Jump5, "player_jester/jump5");
