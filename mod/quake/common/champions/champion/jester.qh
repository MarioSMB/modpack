SOUND(Jester_Land, "player_jester/land");
SOUND(Jester_Fall, "player_jester/land2");

SOUND(Jester_Burn1, "player_jester/lburn1");
SOUND(Jester_Burn2, "player_jester/lburn2");
Sound SND_Jester_Burn_Random() {
	return (random() > 0.5) ? SND_Jester_Burn1 : SND_Jester_Burn2;
}

SOUND(Jester_Drown1, "player_jester/drown1");
SOUND(Jester_Drown2, "player_jester/drown2");
Sound SND_Jester_Drown_Random() {
	return (random() > 0.5) ? SND_Jester_Drown1 : SND_Jester_Drown2;
}

SOUND(Jester_Start1, "player_jester/start1");
SOUND(Jester_Start2, "player_jester/start2");
SOUND(Jester_Start3, "player_jester/start3");
SOUND(Jester_Start4, "player_jester/start4");
Sound SND_Jester_Start_Random() {
	return REGISTRY_GET(Sounds, SND_Jester_Start1.m_id + rint(random() * 3));
}

SOUND(Jester_Step1, "player_jester/foot1");
SOUND(Jester_Step2, "player_jester/foot2");
SOUND(Jester_Step3, "player_jester/foot3");
