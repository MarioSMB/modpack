#ifdef CSQC
const float WHEEL_FRACTION = 0.2; // saves some maths
const float WHEEL_SPEED = 0.65; // TODO: network this, sometimes plays faster!

bool wheel_active;
float wheel_inputblock; // just a small delay to prevent jumping into the wheel triggering it
float wheel_closetime; // shows the wheel a little longer so you know what you got
bool wheel_wasactive;

int wheel_slots[WHEEL_SLOTS]; // selected entry, to be cleared on exit
float wheel_offset[WHEEL_SLOTS]; // scrolling position

entity wheel_sounds;

const int WHEEL_STOPPED = 0;
const int WHEEL_SPINNING = 1;
const int WHEEL_STOPPING = 2;
int wheel_state[WHEEL_SLOTS]; // spinning, stopped

int wheel_currentslot;

bool wheel_input_event(int bInputType, float nPrimary, float nSecondary);

void HUD_Wheel();
