const int WHEEL_ICONS = 5;

enum {
	SLOT_CRYSTAL,
	SLOT_GOBLIN,
	SLOT_SWORD,
	SLOT_POTION,
	SLOT_MANA
};

enum {
	COMBO_NONE,
	COMBO_GOLDEN_ENEMIES,
	COMBO_BUFF_ENEMIES,
	COMBO_DOWNGRADE_TOWER,
	COMBO_UNABLE_REPAIR,
	COMBO_SPEED_ENEMIES,
	COMBO_RANDOM_TELEPORT,
	COMBO_DAMAGE_CORE,
	COMBO_DEBUFF_ENEMIES,
	COMBO_BUFF_PLAYERS,
	COMBO_DAMAGE_ENEMIES,
