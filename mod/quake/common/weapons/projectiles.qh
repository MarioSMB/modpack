REGISTER_PROJECTILE(VORE_SPIKE, NEW(Projectile));
REGISTER_PROJECTILE(SCRAG_SPIKE, NEW(Projectile));
REGISTER_PROJECTILE(KNIGHT_SPIKE, NEW(Projectile));
REGISTER_PROJECTILE(SPELLBOOK_METEOR, NEW(Projectile));

CLASS(Cat, Projectile)
	ATTRIB(Cat, m_mins, vector, '-4 -4 -4');
	ATTRIB(Cat, m_maxs, vector, '4 4 4');
	ATTRIB(Cat, m_speed, float, 1000);
	ATTRIB(Cat, dmg, float, 30);
	ATTRIB(Cat, m_bouncecnt, float, 5);
	ATTRIB(Cat, m_piercecnt, float, 5);
	ATTRIB(Cat, m_bouncefactor, float, 1);
	ATTRIB(Cat, m_bouncestop, float, 0.1);
	ATTRIB(Cat, m_gravity, float, 0.25);
#ifdef SVQC
	METHOD(Cat, m_sound_bounce, Sound(entity actor)) { return SND_MEOWMERE_BOUNCE_RANDOM(); }
	METHOD(Cat, m_sound_pierce, Sound(entity actor)) { return SND_MEOWMERE_BOUNCE_RANDOM(); }
	ATTRIB(Cat, m_effect_pierce, entity, EFFECT_MEOWMERE_GLIMMER);
	ATTRIB(Cat, m_effect_bounce, entity, EFFECT_MEOWMERE_GLIMMER);
#endif
#ifdef CSQC
/* model     */ ATTRIB(Cat, m_model, Model, MDL_PROJECTILE_CAT);
/* trail eff */ ATTRIB(Cat, m_traileffect, entity, EFFECT_MEOWMERE_TRAIL);
#endif
ENDCLASS(Cat)
REGISTER_PROJECTILE(CAT, NEW(Cat));

