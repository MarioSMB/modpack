CLASS(Drill, Projectile)
	ATTRIB(Drill, spawnflags, int, PROJ_FLAG_NOANIMATE);
	ATTRIB(Drill, m_mins, vector, '-3 -3 -3');
	ATTRIB(Drill, m_maxs, vector, '3 3 3');
	ATTRIB(Drill, m_speed, float, 1000);
	ATTRIB(Drill, dmg, float, 25);
	ATTRIB(Drill, dmg_radius, float, 30);
	ATTRIB(Drill, m_piercecnt, int, -1);
	ATTRIB(Drill, m_lifetime, float, 6);
	ATTRIB(Drill, m_avelocity, vector, '0 0 720');
#ifdef SVQC
	METHOD(Drill, m_sound_explode, Sound(entity actor)) { return SND_ROCKET_EXPLOSION; }
	METHOD(Drill, m_sound_pierce, Sound(entity actor)) { return SND_DRILL_LOOP; }
	ATTRIB(Drill, m_effect_explode, entity, EFFECT_TE_PLASMABIG);
	ATTRIB(Drill, m_effect_pierce, entity, EFFECT_DRILL_TOUCH);
#endif
#ifdef CSQC
/* model     */ ATTRIB(Drill, m_model, Model, MDL_PROJECTILE_DRILL);
/* trail eff */ ATTRIB(Drill, m_traileffect, entity, EFFECT_TR_DRILL);
#endif
ENDCLASS(Drill)
REGISTER_PROJECTILE(DRILL, NEW(Drill));

