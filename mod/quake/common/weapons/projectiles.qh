#pragma once

#ifdef GAMEQC
#include "../effects/all.qh"
#include "../physics/movetypes/movetypes.qh"
#endif

#ifdef GAMEQC

const int PROJ_FLAG_NOCULL = BIT(0);
const int PROJ_FLAG_NOANIMATE = BIT(1);
const int PROJ_FLAG_NOCOLLISIONS = BIT(2);
const int PROJ_FLAG_HOMING = BIT(3);

/** fields which are explicitly/manually set are marked with "M", fields set automatically are marked with "A" */
CLASS(Projectile, Object)
	ATTRIB(Projectile, m_id, int, 0);
	ATTRIB(Projectile, spawnflags, int, 0);
	/** M: hitbox mins maxs */
	ATTRIB(Projectile, m_mins, vector, '0 0 0');
	ATTRIB(Projectile, m_maxs, vector, '0 0 0');
	ATTRIB(Projectile, m_spread, float, 0);
	ATTRIB(Projectile, m_spread_style, int, 0);
	ATTRIB(Projectile, m_spread_pattern, int, 0);
	ATTRIB(Projectile, m_spread_pattern_scale, float, 0);
	ATTRIB(Projectile, m_spread_pattern_bias, float, 0);
	ATTRIB(Projectile, m_avelocity, vector, '0 0 0');
	ATTRIB(Projectile, m_scale, float, 0);
	ATTRIB(Projectile, m_lifetime, float, 10);
	ATTRIB(Projectile, m_bouncecnt, int, 0);
	ATTRIB(Projectile, m_piercecnt, int, 0);
	ATTRIB(Projectile, m_speed, float, 0);
	ATTRIB(Projectile, m_count, int, 0);
	ATTRIB(Projectile, dmg, float, 0);
	ATTRIB(Projectile, dmg_radius, float, 0);
	ATTRIB(Projectile, m_gravity, float, 0);
	ATTRIB(Projectile, m_bouncefactor, float, 0);
	ATTRIB(Projectile, m_bouncestop, float, 0);
	METHOD(Projectile, pr_setup, void(Projectile this, entity actor));
	METHOD(Projectile, m_tick, void(Projectile this, entity actor));
	ATTRIB(Projectile, home_range, float, 0);
	ATTRIB(Projectile, home_range_max, float, 0);
	ATTRIB(Projectile, home_speed_decel, float, 0);
	ATTRIB(Projectile, home_speed_accel, float, 0);
	ATTRIB(Projectile, home_speed_max, float, 0);
	ATTRIB(Projectile, home_turn_rate, float, 0);
	ATTRIB(Projectile, home_smart, bool, false);
	ATTRIB(Projectile, home_smart_mindist, float, 0);
	ATTRIB(Projectile, home_smart_trace_min, float, 0);
	ATTRIB(Projectile, home_smart_trace_max, float, 0);
#ifdef SVQC
	METHOD(Projectile, pr_collide, void(Projectile this, entity actor, entity toucher, bool is_touch)) { };
	METHOD(Projectile, pr_bounce, void(Projectile this, entity actor, entity toucher, bool is_touch)) { };
	METHOD(Projectile, pr_explode, void(Projectile this, entity actor, entity directhitentity, bool is_touch));

	/** explode takes priority, impact is otherwise called when hitting something */
	METHOD(Projectile, m_sound_explode, Sound(entity actor)) { return SND_Null; }
	METHOD(Projectile, m_sound_impact, Sound(entity actor)) { return SND_Null; }
	METHOD(Projectile, m_sound_pierce, Sound(entity actor)) { return SND_Null; }
	METHOD(Projectile, m_sound_bounce, Sound(entity actor)) { return SND_Null; }
	ATTRIB(Projectile, m_effect_explode, entity, EFFECT_Null);
	ATTRIB(Projectile, m_effect_impact, entity, EFFECT_Null);
	ATTRIB(Projectile, m_effect_pierce, entity, EFFECT_Null);
	ATTRIB(Projectile, m_effect_bounce, entity, EFFECT_Null);
#endif
#ifdef CSQC
	/** M: model MDL_PROJECTILE_id */
	ATTRIB(Projectile, m_model, entity, MDL_Null);
	/** M: trail effect */
	ATTRIB(Projectile, m_traileffect, entity, EFFECT_Null);
	METHOD(Projectile, pr_drawtrail, vector(Projectile this, entity actor, vector trailorigin)) { return trailorigin; }
	METHOD(Projectile, pr_draw, void(Projectile this, entity actor)) { };
#endif
ENDCLASS(Projectile)

REGISTRY(Projectiles, 255)
REGISTER_REGISTRY(Projectiles)

#define REGISTER_PROJECTILE(id, inst) REGISTER(Projectiles, PROJECTILE, id, m_id, inst)

REGISTER_PROJECTILE(Null, NEW(Projectile));
REGISTRY_DEFINE_GET(Projectiles, PROJECTILE_Null)

REGISTRY_SORT(Projectiles)
REGISTRY_CHECK(Projectiles)

STATIC_INIT(Projectiles) { FOREACH(Projectiles, true, it.m_id = i); }

// standard rocket projectile
CLASS(Rocket, Projectile)
	ATTRIB(Rocket, m_mins, vector, '-3 -3 -3');
	ATTRIB(Rocket, m_maxs, vector, '3 3 3');
	ATTRIB(Rocket, m_speed, float, 1000);
	ATTRIB(Rocket, dmg, float, 100);
	ATTRIB(Rocket, dmg_radius, float, 100);
#ifdef SVQC
	METHOD(Rocket, m_sound_explode, Sound(entity actor)) { return SND_ROCKET_EXPLOSION; }
	ATTRIB(Rocket, m_effect_explode, entity, EFFECT_EXPLOSION);
#endif
#ifdef CSQC
/* model     */ ATTRIB(Rocket, m_model, Model, MDL_PROJECTILE_ROCKET);
/* trail eff */ ATTRIB(Rocket, m_traileffect, entity, EFFECT_TR_ROCKET);
#endif
ENDCLASS(Rocket)
REGISTER_PROJECTILE(ROCKET, NEW(Rocket));

// "spike"
CLASS(Bullet, Projectile)
	ATTRIB(Bullet, m_mins, vector, '-1 -1 -1');
	ATTRIB(Bullet, m_maxs, vector, '1 1 1');
	ATTRIB(Bullet, m_speed, float, 1000);
	ATTRIB(Bullet, dmg, float, 9);
#ifdef SVQC
	METHOD(Bullet, m_sound_impact, Sound(entity actor)) { return (prandom() > 0.6) ? SND_TINK1 : SND_RIC_RANDOM(); }
	ATTRIB(Bullet, m_effect_impact, entity, EFFECT_TE_SPIKE);
#endif
#ifdef CSQC
/* model     */ ATTRIB(Bullet, m_model, Model, MDL_PROJECTILE_BULLET);
#endif
ENDCLASS(Bullet)
REGISTER_PROJECTILE(BULLET, NEW(Bullet));

